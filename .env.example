# FTP-Lantern Configuration

# Web Server Port
PORT=8085

# Target ISP Media Directory URLs (comma-separated if multiple)
SOURCE_URLS=http://172.16.x.x/DHAKA-FLIX-12/TV-WEB-Series/

# Background Crawl Schedule
BASE_CRAWL_INTERVAL_MINUTES=60
CRAWL_CONCURRENCY=4

# Memory Limit Guard for Go Runtime (Leave under container RAM limit)
GOMEMLIMIT=96MiB

# Storage Volume Cap: Maximum disk size for cached thumbnails in MB (auto-prunes oldest)
MAX_THUMBS_MB=250

# Public or LAN Base URL (used in Telegram deep links)
PUBLIC_BASE_URL=http://192.168.0.x:8085

# Telegram Notification Settings
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_ADMIN_CHAT_ID=123456789

# Timezone
TZ=Asia/Dhaka

# Logging
LOG_LEVEL=info
